{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Design tokens for Sevro — Local Home-Service Marketplace (light mode, Bootstrap 5.3 compatible).",
  "color": {
    "brand": {
      "primary": { "$value": "#C2410C", "$type": "color", "$description": "Burnt terracotta-orange primary brand action (5.18:1 on white, harmonizes with Sevro house-pin logo)" },
      "primary-hover": { "$value": "#9A3412", "$type": "color", "$description": "Primary hover/active state (7.31:1 AAA on white)" },
      "primary-soft": { "$value": "#FFF4ED", "$type": "color", "$description": "Warm tint for active nav items, badges, and filter pills" },
      "primary-border": { "$value": "#FDBA74", "$type": "color", "$description": "Subtle warm border for primary pills and highlights" },
      "ink": { "$value": "#0F172A", "$type": "color", "$description": "Deep slate ink for authority panels, headings, and secondary dark buttons" },
      "trust": { "$value": "#1D4ED8", "$type": "color", "$description": "Verified badge and trust accent (6.69:1 on white)" },
      "trust-soft": { "$value": "#EFF6FF", "$type": "color", "$description": "Soft trust blue background for verification callouts" }
    },
    "neutral": {
      "canvas": { "$value": "#F8F7F4", "$type": "color", "$description": "Clean warm alabaster page background" },
      "surface": { "$value": "#FFFFFF", "$type": "color", "$description": "Crisp white card, navbar, and modal surface" },
      "surface-subtle": { "$value": "#F1F0EC", "$type": "color", "$description": "Muted surface for inputs, table headers, and secondary containers" },
      "text": { "$value": "#18181B", "$type": "color", "$description": "Primary body and heading text (17.7:1 AAA on white)" },
      "text-muted": { "$value": "#52525B", "$type": "color", "$description": "Secondary captions, metadata, and helper copy (7.6:1 AAA on white)" },
      "border": { "$value": "#E4E4E7", "$type": "color", "$description": "Default hairline card and control border" },
      "border-strong": { "$value": "#D4D4D8", "$type": "color", "$description": "Hover border and emphasized dividers" }
    },
    "status": {
      "pending": { "$value": "#B45309", "$type": "color" },
      "pending-bg": { "$value": "#FEF3C7", "$type": "color" },
      "pending-dot": { "$value": "#F59E0B", "$type": "color" },
      "confirmed": { "$value": "#1D4ED8", "$type": "color" },
      "confirmed-bg": { "$value": "#EFF6FF", "$type": "color" },
      "confirmed-dot": { "$value": "#2563EB", "$type": "color" },
      "inprogress": { "$value": "#0E7490", "$type": "color" },
      "inprogress-bg": { "$value": "#ECFEFF", "$type": "color" },
      "inprogress-dot": { "$value": "#0891B2", "$type": "color" },
      "completed": { "$value": "#15803D", "$type": "color" },
      "completed-bg": { "$value": "#F0FDF4", "$type": "color" },
      "completed-dot": { "$value": "#16A34A", "$type": "color" },
      "destructive": { "$value": "#DC2626", "$type": "color" },
      "destructive-text": { "$value": "#B91C1C", "$type": "color" },
      "destructive-bg": { "$value": "#FEF2F2", "$type": "color" },
      "rating": { "$value": "#F59E0B", "$type": "color" }
    }
  },
  "font": {
    "heading": { "$value": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "$type": "fontFamily" },
    "body": { "$value": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "$type": "fontFamily" }
  },
  "space": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "20px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "xs": { "$value": "0 1px 2px rgba(15, 23, 42, 0.05)", "$type": "shadow" },
    "sm": { "$value": "0 2px 8px rgba(15, 23, 42, 0.06)", "$type": "shadow" },
    "md": { "$value": "0 8px 24px rgba(15, 23, 42, 0.08)", "$type": "shadow" },
    "lg": { "$value": "0 16px 40px rgba(15, 23, 42, 0.12)", "$type": "shadow" }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{color.brand.primary}", "$type": "color" },
      "on-primary": { "$value": "#FFFFFF", "$type": "color" },
      "secondary": { "$value": "{color.brand.ink}", "$type": "color" },
      "on-secondary": { "$value": "#FFFFFF", "$type": "color" },
      "accent": { "$value": "{color.brand.trust}", "$type": "color" },
      "on-accent": { "$value": "#FFFFFF", "$type": "color" },
      "background": { "$value": "{color.neutral.canvas}", "$type": "color" },
      "foreground": { "$value": "{color.neutral.text}", "$type": "color" },
      "card": { "$value": "{color.neutral.surface}", "$type": "color" },
      "card-foreground": { "$value": "{color.neutral.text}", "$type": "color" },
      "muted": { "$value": "{color.neutral.surface-subtle}", "$type": "color" },
      "muted-foreground": { "$value": "{color.neutral.text-muted}", "$type": "color" },
      "border": { "$value": "{color.neutral.border}", "$type": "color" },
      "destructive": { "$value": "{color.status.destructive}", "$type": "color" },
      "on-destructive": { "$value": "#FFFFFF", "$type": "color" },
      "ring": { "$value": "{color.brand.primary}", "$type": "color" }
    },
    "font": {
      "heading": { "$value": "{font.heading}", "$type": "fontFamily" },
      "body": { "$value": "{font.body}", "$type": "fontFamily" }
    }
  }
}
