@model Sevro.ViewModels.Admin.CategoryFormViewModel
@{
    var isEdit = Model.CategoryId > 0;
    ViewData["Title"] = isEdit ? "Edit Category" : "Create Category";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none text-terracotta">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Categories" class="text-decoration-none text-terracotta">Categories</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                </ol>
            </nav>

            <div class="sc-card sc-card-accent p-4 p-md-5 sc-reveal">
                <div class="sc-form-header">
                    <span class="sc-form-icon"><i class="bi @(string.IsNullOrWhiteSpace(Model.IconClass) ? "bi-tags-fill" : Model.IconClass)" aria-hidden="true"></i></span>
                    <div>
                        <div class="sc-section-eyebrow mb-0">Admin Catalog</div>
                        <h2 class="h4 fw-bold mb-0">@ViewData["Title"]</h2>
                        <p class="text-muted small mb-0">Configure category name, icon or uploaded image, display order, and active status.</p>
                    </div>
                </div>

                <form asp-action="@(isEdit ? "EditCategory" : "CreateCategory")" method="post" enctype="multipart/form-data" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="ExistingImagePath" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <div class="form-floating">
                                <input asp-for="CategoryName" class="form-control" placeholder="e.g., Electrical Services" />
                                <label asp-for="CategoryName"></label>
                                <span asp-validation-for="CategoryName"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="DisplayOrder" type="number" min="0" max="999" class="form-control sc-tabular" placeholder="1" />
                                <label asp-for="DisplayOrder"></label>
                                <span asp-validation-for="DisplayOrder"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="IconClass" class="form-control" placeholder="bi-lightning-charge-fill" />
                                <label asp-for="IconClass"></label>
                                <span asp-validation-for="IconClass"></span>
                                <div class="form-text">Bootstrap Icon class (e.g., <code>bi-droplet-fill</code>, <code>bi-tools</code>).</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IconImageFile" class="form-label small fw-semibold mb-1"></label>
                            <input asp-for="IconImageFile" type="file" accept=".png,.jpg,.jpeg,.webp,.svg" class="form-control" />
                            @if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
                            {
                                <div class="form-text">Current: <a href="@Model.ExistingImagePath" target="_blank" class="text-terracotta">View uploaded icon</a></div>
                            }
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Description" class="form-control" style="height: 100px;" placeholder="Brief description of this category"></textarea>
                        <label asp-for="Description"></label>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label small fw-semibold"></label>
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-terracotta sc-btn-sheen px-4 py-2 d-inline-flex align-items-center gap-2">
                            <span>@(isEdit ? "Update Category" : "Create Category")</span>
                            <i class="bi bi-arrow-right sc-cta-arrow" aria-hidden="true"></i>
                        </button>
                        <a asp-action="Categories" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
