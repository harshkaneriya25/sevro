@model Sevro.ViewModels.Admin.CategoryFormViewModel
@{
    var isEdit = Model.CategoryId > 0;
    ViewData["Title"] = isEdit ? "Edit Category" : "Create Category";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="sc-card p-4 p-md-5 border-0 shadow-sm">
                <h2 class="h4 fw-bold mb-1">@ViewData["Title"]</h2>
                <p class="text-muted small mb-4">Define a clear category name and short summary for customers and providers.</p>

                <form asp-action="@(isEdit ? "EditCategory" : "CreateCategory")" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CategoryId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="CategoryName" class="form-control" placeholder="e.g., Plumbing" />
                        <label asp-for="CategoryName"></label>
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control" style="height: 100px;" placeholder="Brief description of this category"></textarea>
                        <label asp-for="Description"></label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-terracotta px-4">@(isEdit ? "Update Category" : "Create Category")</button>
                        <a asp-action="Categories" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
