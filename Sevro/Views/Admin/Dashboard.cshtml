@model Sevro.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Admin Control Center</h1>
            <p class="text-muted mb-0">Monitor users, verify service providers, manage categories, and oversee all bookings.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Categories" class="btn btn-outline-secondary btn-sm"><i class="bi bi-tags me-1"></i> Categories (@Model.TotalCategories)</a>
            <a asp-action="Providers" asp-route-filter="pending" class="btn btn-terracotta btn-sm"><i class="bi bi-patch-check me-1"></i> Verify Providers</a>
        </div>
    </div>

    <!-- 4 Summary Metric Tiles -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="sc-metric-tile shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted fw-medium">Total Users</div>
                        <div class="fs-2 fw-bold mt-1">@Model.TotalUsers</div>
                    </div>
                    <span class="sc-metric-icon bg-terracotta-soft"><i class="bi bi-people-fill"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-metric-tile shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted fw-medium">Service Providers</div>
                        <div class="fs-2 fw-bold mt-1 text-primary">@Model.TotalProviders</div>
                    </div>
                    <span class="sc-metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-building"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-metric-tile shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted fw-medium">Pending Approvals</div>
                        <div class="fs-2 fw-bold mt-1 text-warning">@Model.PendingVerifications</div>
                    </div>
                    <span class="sc-metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-shield-exclamation"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-metric-tile shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted fw-medium">Platform Bookings</div>
                        <div class="fs-2 fw-bold mt-1 text-success">@Model.TotalBookings</div>
                    </div>
                    <span class="sc-metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-journal-check"></i></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Pending Provider Verifications -->
        <div class="col-lg-5">
            <div class="sc-card border-0 shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Pending Provider Verifications</h5>
                    <a asp-action="Providers" class="small text-terracotta text-decoration-none fw-semibold">View All</a>
                </div>

                @if (!Model.PendingProviders.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-check-circle text-success fs-3 d-block mb-2"></i>
                        All registered providers are verified!
                    </div>
                }
                else
                {
                    <div class="vstack gap-3">
                        @foreach (var p in Model.PendingProviders)
                        {
                            <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="fw-bold">@p.BusinessName</div>
                                    <div class="small text-muted">@p.User.FullName &bull; @p.City &bull; @p.ExperienceYears yrs</div>
                                </div>
                                <form asp-action="VerifyProvider" asp-route-id="@p.ProviderProfileId" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Admin")" />
                                    <button type="submit" class="btn btn-sm btn-success">Verify</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Recent Platform Bookings -->
        <div class="col-lg-7">
            <div class="sc-card border-0 shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Platform Bookings</h5>
                    <a asp-action="Bookings" class="small text-terracotta text-decoration-none fw-semibold">Manage All</a>
                </div>

                @if (!Model.RecentBookings.Any())
                {
                    <div class="text-center py-4 text-muted small">No bookings have been placed yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle table-sm mb-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th>ID</th>
                                    <th>Service</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.RecentBookings)
                                {
                                    <tr>
                                        <td class="fw-semibold">#@b.BookingId</td>
                                        <td>
                                            <div class="fw-medium">@b.ProviderService.ServiceName</div>
                                            <small class="text-muted">@b.ProviderService.ProviderProfile.BusinessName</small>
                                        </td>
                                        <td>@b.Customer.FullName</td>
                                        <td class="small">@b.BookingDate.ToString("dd MMM")</td>
                                        <td><partial name="_StatusBadgePartial" model="b.Status" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
