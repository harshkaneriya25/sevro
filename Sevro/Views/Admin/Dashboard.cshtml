@model Sevro.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="sc-page-header sc-reveal">
    <div>
        <div class="sc-section-eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Admin Portal</div>
        <h1 class="h3 fw-bold mb-1">Admin Control Center</h1>
        <p class="text-muted small mb-0">Monitor users, verify service providers, manage categories, and oversee all bookings.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Services" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-card-list me-1" aria-hidden="true"></i> Service Catalog (@Model.TotalCatalogServices)
        </a>
        <a asp-action="Categories" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-tags me-1" aria-hidden="true"></i> Categories (@Model.TotalCategories)
        </a>
        <a asp-action="Providers" asp-route-filter="pending" class="btn btn-terracotta btn-sm sc-btn-sheen rounded-pill px-3 d-inline-flex align-items-center gap-1">
            <i class="bi bi-patch-check" aria-hidden="true"></i>
            <span>Verify Providers (@Model.PendingVerifications)</span>
        </a>
    </div>
</div>

<!-- 4 Summary Metric Tiles -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 0ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Total Users</div>
                    <div class="fs-2 fw-bold mt-1 sc-tabular">@Model.TotalUsers</div>
                </div>
                <span class="sc-metric-icon bg-terracotta-soft"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 50ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Service Providers</div>
                    <div class="fs-2 fw-bold mt-1 text-primary sc-tabular">@Model.TotalProviders</div>
                </div>
                <span class="sc-metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-building" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 100ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Pending Approvals</div>
                    <div class="fs-2 fw-bold mt-1 text-warning sc-tabular">@Model.PendingVerifications</div>
                </div>
                <span class="sc-metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 150ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Platform Bookings</div>
                    <div class="fs-2 fw-bold mt-1 text-success sc-tabular">@Model.TotalBookings</div>
                </div>
                <span class="sc-metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-journal-check" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Pending Provider Verifications -->
    <div class="col-xl-5 sc-reveal" style="--sc-delay: 120ms;">
        <div class="sc-card sc-card-accent p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h5 class="h6 fw-bold mb-0"><i class="bi bi-patch-check text-terracotta me-2" aria-hidden="true"></i>Pending Verifications</h5>
                <a asp-action="Providers" class="small text-terracotta text-decoration-none fw-semibold sc-link-arrow d-inline-flex align-items-center gap-1">
                    <span>View All</span><i class="bi bi-arrow-right sc-cta-arrow" aria-hidden="true"></i>
                </a>
            </div>

            @if (!Model.PendingProviders.Any())
            {
                <div class="text-center py-4">
                    <div class="sc-empty-icon" style="width:48px;height:48px;font-size:1.3rem;">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    </div>
                    <div class="fw-semibold small mb-1">All caught up!</div>
                    <div class="text-muted small">All registered service providers are verified.</div>
                </div>
            }
            else
            {
                <div class="vstack gap-3">
                    @foreach (var p in Model.PendingProviders)
                    {
                        var abbr = string.Concat(p.BusinessName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
                        <div class="p-3 rounded-3 border d-flex justify-content-between align-items-center gap-2" style="background-color: var(--color-background);">
                            <div class="d-flex align-items-center gap-2 min-w-0">
                                <span class="sc-row-avatar">@abbr</span>
                                <div class="min-w-0">
                                    <div class="fw-bold small text-truncate">@p.BusinessName</div>
                                    <div class="text-muted text-truncate" style="font-size:0.76rem;">@p.User.FullName &bull; @p.City &bull; @p.ExperienceYears yrs</div>
                                </div>
                            </div>
                            <form asp-action="VerifyProvider" asp-route-id="@p.ProviderProfileId" method="post" class="flex-shrink-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Admin")" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-check2 me-1" aria-hidden="true"></i>Verify
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Recent Platform Bookings -->
    <div class="col-xl-7 sc-reveal" style="--sc-delay: 160ms;">
        <div class="sc-card p-0 overflow-hidden h-100">
            <div class="d-flex justify-content-between align-items-center p-4 pb-3 border-bottom">
                <h5 class="h6 fw-bold mb-0"><i class="bi bi-journal-text text-terracotta me-2" aria-hidden="true"></i>Recent Platform Bookings</h5>
                <a asp-action="Bookings" class="small text-terracotta text-decoration-none fw-semibold sc-link-arrow d-inline-flex align-items-center gap-1">
                    <span>Manage All</span><i class="bi bi-arrow-right sc-cta-arrow" aria-hidden="true"></i>
                </a>
            </div>

            @if (!Model.RecentBookings.Any())
            {
                <div class="text-center py-5 text-muted small">No bookings have been placed yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="small text-uppercase text-muted">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Service</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th class="pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.RecentBookings)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold sc-tabular">#@b.BookingId</td>
                                    <td>
                                        <div class="fw-semibold small">@b.ProviderService.ServiceName</div>
                                        <small class="text-muted">@b.ProviderService.ProviderProfile.BusinessName</small>
                                    </td>
                                    <td class="small">@b.Customer.FullName</td>
                                    <td class="small text-muted sc-tabular">@b.BookingDate.ToString("dd MMM")</td>
                                    <td class="pe-4"><partial name="_StatusBadgePartial" model="b.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
