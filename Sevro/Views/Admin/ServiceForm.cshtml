@model Sevro.ViewModels.Admin.CatalogServiceFormViewModel
@using Sevro.Helpers
@using Sevro.Models.Enums
@{
    var isEdit = Model.CatalogServiceId > 0;
    ViewData["Title"] = isEdit ? "Edit Catalog Service" : "Add Catalog Service";
}

<div class="container py-2 py-lg-3">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none text-terracotta">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Services" class="text-decoration-none text-terracotta">Service Catalog</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                </ol>
            </nav>

            <div class="sc-card sc-card-accent p-4 p-md-5">
                <div class="sc-form-header">
                    <span class="sc-form-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
                    <div>
                        <div class="sc-section-eyebrow mb-0">Master Catalog</div>
                        <h2 class="h4 fw-bold mb-0">@ViewData["Title"]</h2>
                        <p class="text-muted small mb-0">Set transparent, affordable INR pricing, unit, duration, and visibility.</p>
                    </div>
                </div>

                <form asp-action="@(isEdit ? "EditService" : "CreateService")" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CatalogServiceId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold small mb-1"></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select sc-input-lg">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold small mb-1"></label>
                            <input asp-for="Name" class="form-control sc-input-lg" placeholder="e.g., Fan installation" />
                            <span asp-validation-for="Name"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6 col-lg-4">
                            <label asp-for="PricingType" class="form-label fw-semibold small mb-1"></label>
                            <select asp-for="PricingType" class="form-select sc-input-lg" id="adminPricingType">
                                @foreach (var pt in Enum.GetValues<PricingType>())
                                {
                                    <option value="@pt">@PricingFormatter.GetPricingTypeLabel(pt)</option>
                                }
                            </select>
                            <span asp-validation-for="PricingType"></span>
                        </div>
                        <div class="col-md-6 col-lg-4" id="adminPriceWrap">
                            <label asp-for="Price" class="form-label fw-semibold small mb-1"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted fw-semibold">&#8377;</span>
                                <input asp-for="Price" type="number" step="1" min="0" class="form-control sc-input-lg sc-tabular" id="adminPriceInput" placeholder="199" />
                            </div>
                            <span asp-validation-for="Price"></span>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <label asp-for="Unit" class="form-label fw-semibold small mb-1"></label>
                            <input asp-for="Unit" class="form-control sc-input-lg" placeholder="Per job / Per hour / Per visit" />
                            <span asp-validation-for="Unit"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="EstimatedDuration" class="form-label fw-semibold small mb-1"></label>
                            <input asp-for="EstimatedDuration" class="form-control sc-input-lg" placeholder="e.g., 30–45 mins" />
                            <span asp-validation-for="EstimatedDuration"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="w-100 px-3 py-2 rounded-3 border bg-light d-flex flex-wrap align-items-center gap-4" style="min-height: 46px;">
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                    <label asp-for="IsActive" class="form-check-label small fw-semibold"></label>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="IsPopular" class="form-check-input" type="checkbox" role="switch" />
                                    <label asp-for="IsPopular" class="form-check-label small fw-semibold"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold small mb-1"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="What does this service include?"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-terracotta sc-btn-sheen px-4 py-2 d-inline-flex align-items-center gap-2">
                            <span>@(isEdit ? "Update Service" : "Save Service")</span>
                            <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        </button>
                        <a asp-action="Services" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-service-form.js" asp-append-version="true"></script>
}
