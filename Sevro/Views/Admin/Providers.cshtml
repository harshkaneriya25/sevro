@model List<Sevro.Models.ProviderProfile>
@{
    ViewData["Title"] = "Verify Service Providers";
    var filter = ViewBag.Filter as string;
}

<div class="sc-page-header sc-reveal">
    <div>
        <div class="sc-section-eyebrow"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> Trust &amp; Safety</div>
        <h1 class="h3 fw-bold mb-1">Verify Service Providers</h1>
        <p class="text-muted small mb-0">Approve or revoke registered service providers before their services appear in the public catalog.</p>
    </div>
    <div class="sc-pill-dock">
        <a asp-action="Providers" class="btn btn-sm @(string.IsNullOrEmpty(filter) ? "btn-terracotta" : "btn-outline-secondary")">All</a>
        <a asp-action="Providers" asp-route-filter="pending" class="btn btn-sm @(filter == "pending" ? "btn-terracotta" : "btn-outline-secondary")">Pending</a>
        <a asp-action="Providers" asp-route-filter="verified" class="btn btn-sm @(filter == "verified" ? "btn-terracotta" : "btn-outline-secondary")">Verified</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="sc-empty-state">
        <div class="sc-empty-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></div>
        <h5 class="fw-bold">No service providers found</h5>
        <p class="text-muted small mb-0">There are currently no providers matching this filter.</p>
    </div>
}
else
{
    <div class="sc-card p-0 overflow-hidden sc-reveal">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="small text-uppercase text-muted">
                    <tr>
                        <th class="ps-4">Business &amp; Owner</th>
                        <th>City &amp; Experience</th>
                        <th>Services</th>
                        <th>Availability</th>
                        <th>Verification</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody data-sc-paginate="8">
                    @foreach (var p in Model)
                    {
                        var abbr = string.Concat(p.BusinessName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-start gap-3">
                                    <span class="sc-row-avatar mt-1">@abbr</span>
                                    <div>
                                        <div class="fw-bold">@p.BusinessName</div>
                                        <div class="small text-muted">@p.User.FullName &bull; @p.User.Email &bull; @p.User.PhoneNumber</div>
                                        @if (!string.IsNullOrWhiteSpace(p.Description))
                                        {
                                            <div class="small text-muted mt-1 sc-line-clamp-2">@p.Description</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="small">
                                <div class="fw-medium">@p.City</div>
                                <div class="text-muted sc-tabular">@p.ExperienceYears yrs exp</div>
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-light text-dark border sc-tabular px-3 py-1">@p.Services.Count</span>
                            </td>
                            <td>
                                <span class="sc-status-pill @(p.IsAvailable ? "sc-status-completed" : "sc-status-muted")">
                                    <span class="sc-status-dot" aria-hidden="true"></span>
                                    @(p.IsAvailable ? "Available" : "Unavailable")
                                </span>
                            </td>
                            <td>
                                @if (p.IsVerified)
                                {
                                    <span class="sc-status-pill sc-status-confirmed">
                                        <i class="bi bi-patch-check-fill" aria-hidden="true"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="sc-status-pill sc-status-pending">
                                        <span class="sc-status-dot" aria-hidden="true"></span> Pending
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="sc-action-group">
                                    @if (!p.IsVerified)
                                    {
                                        <form asp-action="VerifyProvider" asp-route-id="@p.ProviderProfileId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check2-circle" aria-hidden="true"></i><span>Verify</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="RejectProvider" asp-route-id="@p.ProviderProfileId" method="post" class="d-inline" onsubmit="return confirm('Revoke verification for this provider?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i><span>Revoke</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
