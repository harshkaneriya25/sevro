@model List<Sevro.ViewModels.Admin.UserListItemViewModel>
@{
    ViewData["Title"] = "Manage Users";
    var roleFilter = ViewBag.RoleFilter as string;
    var search = ViewBag.Search as string;
}

<div class="sc-page-header sc-reveal">
    <div>
        <div class="sc-section-eyebrow"><i class="bi bi-people-fill" aria-hidden="true"></i> User Directory</div>
        <h1 class="h3 fw-bold mb-1">Manage Users</h1>
        <p class="text-muted small mb-0">View and manage all registered Customers, Service Providers, and Admins.</p>
    </div>
    <span class="sc-status-pill sc-status-confirmed bg-white border shadow-sm px-3 py-2">
        <span class="sc-status-dot" aria-hidden="true"></span>
        <strong class="sc-tabular">@Model.Count</strong> @(Model.Count == 1 ? "user" : "users")
    </span>
</div>

<!-- Filter Form -->
<form asp-action="Users" method="get" class="sc-card sc-card-accent p-3 mb-4 sc-reveal">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Search by name, email, or business name..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="role" class="form-select">
                <option value="">All Roles</option>
                <option value="Customer" selected="@(roleFilter == "Customer")">Customer</option>
                <option value="Provider" selected="@(roleFilter == "Provider")">Provider</option>
                <option value="Admin" selected="@(roleFilter == "Admin")">Admin</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <button type="submit" class="btn btn-terracotta w-100">Filter</button>
        </div>
        <div class="col-6 col-md-2">
            <a asp-action="Users" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="sc-empty-state">
        <div class="sc-empty-icon"><i class="bi bi-people" aria-hidden="true"></i></div>
        <h5 class="fw-bold">No matching users found</h5>
        <p class="text-muted small mb-3">Try adjusting your role filter or search query.</p>
        <a asp-action="Users" class="btn btn-outline-terracotta btn-sm rounded-pill px-4">Reset Filters</a>
    </div>
}
else
{
    <div class="sc-card p-0 overflow-hidden sc-reveal">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="small text-uppercase text-muted">
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Role</th>
                        <th>Phone</th>
                        <th>Joined</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody data-sc-paginate="8">
                    @foreach (var u in Model)
                    {
                        var initials = string.Concat(u.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="sc-row-avatar">@initials</span>
                                    <div>
                                        <div class="fw-semibold">@u.FullName</div>
                                        <div class="small text-muted">@u.Email</div>
                                        @if (!string.IsNullOrWhiteSpace(u.BusinessName))
                                        {
                                            <div class="small text-terracotta fw-medium"><i class="bi bi-building me-1" aria-hidden="true"></i>@u.BusinessName</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill @(u.Role == "Admin" ? "bg-dark text-white" : u.Role == "Provider" ? "bg-primary bg-opacity-10 text-primary" : "bg-terracotta-soft") px-3 py-1">
                                    @u.Role
                                </span>
                            </td>
                            <td class="small sc-tabular">@(u.PhoneNumber ?? "—")</td>
                            <td class="small text-muted sc-tabular">@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="sc-status-pill sc-status-danger"><span class="sc-status-dot" aria-hidden="true"></span> Suspended</span>
                                }
                                else
                                {
                                    <span class="sc-status-pill sc-status-completed"><span class="sc-status-dot" aria-hidden="true"></span> Active</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="sc-action-group">
                                    @if (u.Role != "Admin")
                                    {
                                        <form asp-action="ToggleUserLock" asp-route-id="@u.UserId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(u.IsLockedOut ? "btn-outline-success" : "btn-outline-danger")">
                                                <i class="bi @(u.IsLockedOut ? "bi-unlock" : "bi-slash-circle")" aria-hidden="true"></i>
                                                <span>@(u.IsLockedOut ? "Reactivate" : "Suspend")</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="small text-muted"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Protected</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
