@model Sevro.ViewModels.Catalog.HomeViewModel
@{
    ViewData["Title"] = "Find Trusted Local Service Professionals";
}

<!-- Hero Section -->
<section class="sc-hero py-5">
    <div class="container py-lg-4">
        <div class="row align-items-center gy-4">
            <div class="col-lg-7">
                <span class="badge rounded-pill bg-terracotta-soft px-3 py-2 mb-3 fw-semibold">
                    <i class="bi bi-patch-check-fill me-1"></i> Verified Local Professionals
                </span>
                <h1 class="display-5 fw-bold lh-sm mb-3">
                    Reliable Home &amp; Local Services, Booked in Minutes.
                </h1>
                <p class="lead text-muted mb-4">
                    Connect directly with admin-verified electricians, plumbers, cleaners, painters, and mechanics in your city. Transparent fixed prices &mdash; pay directly after service completion.
                </p>

                <form asp-controller="Services" asp-action="Index" method="get" class="bg-white p-2 rounded-3 shadow-sm border d-flex flex-column flex-sm-row gap-2 mb-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-0 shadow-none" placeholder="Search plumbing, switchboard repair, painting..." />
                    </div>
                    <button type="submit" class="btn btn-terracotta px-4 py-2 text-nowrap">
                        Search Services
                    </button>
                </form>

                <div class="d-flex flex-wrap gap-4 text-muted small">
                    <div>
                        <span class="fw-bold text-dark fs-5">@Model.TotalVerifiedProviders+</span>
                        <div>Verified Providers</div>
                    </div>
                    <div class="vr"></div>
                    <div>
                        <span class="fw-bold text-dark fs-5">@Model.TotalServices+</span>
                        <div>Fixed-Price Services</div>
                    </div>
                    <div class="vr"></div>
                    <div>
                        <span class="fw-bold text-dark fs-5">@Model.TotalCompletedBookings+</span>
                        <div>Completed Jobs</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="sc-card p-4 border-0 shadow-sm">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="~/images/favicon.png" alt="Sevro" style="width: 52px; height: 52px; object-fit: contain;" asp-append-version="true" />
                        <div>
                            <h5 class="fw-bold mb-0">How Sevro Works</h5>
                            <small class="text-muted">Simple 3-step local booking</small>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-3">
                        <span class="badge rounded-circle bg-terracotta d-flex align-items-center justify-content-center" style="width:28px;height:28px;">1</span>
                        <div>
                            <div class="fw-semibold">Browse Verified Services</div>
                            <small class="text-muted">Filter by category, city, price, and live availability.</small>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-3">
                        <span class="badge rounded-circle bg-terracotta d-flex align-items-center justify-content-center" style="width:28px;height:28px;">2</span>
                        <div>
                            <div class="fw-semibold">Pick Date &amp; Saved Address</div>
                            <small class="text-muted">Book in one click with transparent fixed pricing.</small>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <span class="badge rounded-circle bg-terracotta d-flex align-items-center justify-content-center" style="width:28px;height:28px;">3</span>
                        <div>
                            <div class="fw-semibold">Track Progress &amp; Review</div>
                            <small class="text-muted">Follow live status updates and rate completed jobs.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Browse by Category -->
<section class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">Browse by Category</h2>
            <p class="text-muted mb-0">Explore local specialists across essential home &amp; maintenance categories.</p>
        </div>
        <a asp-controller="Services" asp-action="Index" class="btn btn-outline-terracotta btn-sm">View All Services</a>
    </div>

    @if (!Model.Categories.Any())
    {
        <div class="sc-card p-4 text-center text-muted small">
            No service categories added yet. Admin can create categories from the Admin Dashboard.
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
            @foreach (var cat in Model.Categories)
            {
                var icon = cat.CategoryName.ToLowerInvariant() switch
                {
                    "plumbing" => "bi-droplet-fill",
                    "electrical" => "bi-lightning-charge-fill",
                    "cleaning" => "bi-stars",
                    "painting" => "bi-brush-fill",
                    "mechanics" => "bi-wrench-adjustable-circle-fill",
                    "repairing" => "bi-tools",
                    _ => "bi-grid-fill"
                };
                <div class="col">
                    <a asp-controller="Services" asp-action="Index" asp-route-categoryId="@cat.CategoryId" class="sc-category-tile d-block p-3 text-center h-100">
                        <div class="fs-2 text-terracotta mb-2"><i class="bi @icon"></i></div>
                        <div class="fw-semibold">@cat.CategoryName</div>
                    </a>
                </div>
            }
        </div>
    }
</section>

<!-- Featured Services -->
<section class="container pb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">Top-Rated Local Services</h2>
            <p class="text-muted mb-0">Offered by admin-verified service providers with upfront pricing.</p>
        </div>
        <a asp-controller="Services" asp-action="Providers" class="btn btn-link text-terracotta text-decoration-none fw-semibold">
            Explore Providers <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (!Model.FeaturedServices.Any())
    {
        <div class="sc-card p-5 text-center text-muted">
            No services listed yet. Register as a Service Provider to add your first service!
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var svc in Model.FeaturedServices)
            {
                <div class="col">
                    <div class="card sc-service-card h-100">
                        <div class="position-relative">
                            <img src="@svc.ThumbnailUrl" alt="@svc.CategoryName" class="sc-card-thumb" />
                            <span class="badge bg-white text-dark shadow-sm position-absolute top-0 start-0 m-3">@svc.CategoryName</span>
                            @if (svc.IsAvailable)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-3">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary position-absolute top-0 end-0 m-3">Unavailable</span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold mb-1">@svc.ServiceName</h5>
                            <a asp-controller="Services" asp-action="ProviderDetails" asp-route-id="@svc.ProviderProfileId" class="text-decoration-none text-muted small mb-2 d-inline-flex align-items-center gap-1">
                                <span>@svc.BusinessName</span>
                                @if (svc.IsVerified)
                                {
                                    <i class="bi bi-patch-check-fill text-primary" title="Verified Provider"></i>
                                }
                                <span>&bull; @svc.City</span>
                            </a>
                            <div class="d-flex justify-content-between align-items-center mb-3 mt-auto pt-2">
                                <span class="small fw-semibold">
                                    <span class="text-warning">&#9733;</span>
                                    @(svc.ReviewCount > 0 ? svc.AverageRating.ToString("0.0") : "New")
                                    <span class="text-muted fw-normal">(@svc.ReviewCount @(svc.ReviewCount == 1 ? "review" : "reviews"))</span>
                                </span>
                                <span class="fs-5 fw-bold text-dark">&#8377;@svc.Price.ToString("N0")</span>
                            </div>

                            @if (svc.IsAvailable)
                            {
                                <a asp-controller="Customer" asp-action="Book" asp-route-id="@svc.ProviderServiceId" class="btn btn-terracotta w-100">
                                    Book Service
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>Currently Unavailable</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<!-- Provider CTA -->
<section class="container pb-4">
    <div class="sc-auth-brand-panel rounded-4 p-4 p-md-5 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1">Are you a skilled local professional?</h3>
            <p class="mb-0 opacity-75">Create your free Sevro business profile, list your services with fixed pricing, and receive direct local bookings.</p>
        </div>
        <a asp-controller="Account" asp-action="Register" asp-route-role="Provider" class="btn btn-light fw-semibold px-4 py-2 text-nowrap">
            Join as a Provider
        </a>
    </div>
</section>
