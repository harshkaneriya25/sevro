@model List<Sevro.Models.Review>
@{
    ViewData["Title"] = "Customer Reviews";
    double avgRating = ViewBag.AverageRating is double d ? d : 0;
    int reviewCount = ViewBag.ReviewCount is int c ? c : 0;
}

<div class="sc-card sc-card-accent p-4 mb-4 sc-reveal d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <div class="sc-section-eyebrow mb-1"><i class="bi bi-star-fill" aria-hidden="true"></i> Reputation</div>
        <h1 class="h3 fw-bold mb-1">Customer Reviews &amp; Ratings</h1>
        <p class="text-muted small mb-0">Verified feedback left by customers after completed jobs for <strong>@ViewBag.BusinessName</strong>.</p>
    </div>
    <div class="sc-kpi-pill text-center px-4">
        <div class="fs-3 fw-bold sc-tabular">
            <i class="bi bi-star-fill text-warning me-1" aria-hidden="true"></i>@(reviewCount > 0 ? avgRating.ToString("0.0") : "New")
        </div>
        <small class="text-muted">@reviewCount total @(reviewCount == 1 ? "review" : "reviews")</small>
    </div>
</div>

@if (!Model.Any())
{
    <div class="sc-empty-state">
        <div class="sc-empty-icon"><i class="bi bi-chat-square-quote" aria-hidden="true"></i></div>
        <h5 class="fw-bold">No customer reviews yet</h5>
        <p class="text-muted small mb-0">Completed bookings allow customers to rate your service from 1 to 5 stars.</p>
    </div>
}
else
{
    <div class="row g-3" data-sc-paginate="6">
        @foreach (var rev in Model)
        {
            var abbr = string.Concat(rev.Customer.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
            <div class="col-md-6">
                <div class="sc-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="sc-row-avatar">@abbr</span>
                            <div>
                                <div class="fw-bold small">@rev.Customer.FullName</div>
                                <small class="text-muted">@rev.Booking.ProviderService.ServiceName &bull; #@rev.BookingId</small>
                            </div>
                        </div>
                        <span class="sc-status-pill sc-status-pending sc-tabular">
                            <i class="bi bi-star-fill text-warning" aria-hidden="true"></i> @rev.Rating / 5
                        </span>
                    </div>
                    <p class="text-muted small mb-3 flex-grow-1">@(string.IsNullOrWhiteSpace(rev.Comment) ? "No additional comment provided." : rev.Comment)</p>
                    <small class="text-muted sc-tabular"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@rev.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                </div>
            </div>
        }
    </div>
}
