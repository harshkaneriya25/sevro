@model List<Sevro.Models.Review>
@{
    ViewData["Title"] = "Customer Reviews";
    double avgRating = ViewBag.AverageRating is double d ? d : 0;
    int reviewCount = ViewBag.ReviewCount is int c ? c : 0;
}

<div class="container py-4">
    <div class="sc-card p-4 border-0 shadow-sm mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Customer Reviews &amp; Ratings</h1>
            <p class="text-muted mb-0">Verified feedback left by customers after completed jobs for <strong>@ViewBag.BusinessName</strong>.</p>
        </div>
        <div class="bg-light rounded-3 px-4 py-2 text-center border">
            <div class="fs-3 fw-bold">
                <span class="text-warning">&#9733;</span> @(reviewCount > 0 ? avgRating.ToString("0.0") : "New")
            </div>
            <small class="text-muted">@reviewCount total @(reviewCount == 1 ? "review" : "reviews")</small>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="sc-card p-5 text-center border-0 shadow-sm">
            <i class="bi bi-chat-square-quote display-5 text-muted"></i>
            <h5 class="fw-bold mt-3">No customer reviews yet</h5>
            <p class="text-muted small mb-0">Completed bookings allow customers to rate your service from 1 to 5 stars.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var rev in Model)
            {
                <div class="col-md-6">
                    <div class="sc-card p-4 border-0 shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="fw-bold">@rev.Customer.FullName</div>
                                <small class="text-muted">@rev.Booking.ProviderService.ServiceName &bull; Booking #@rev.BookingId</small>
                            </div>
                            <span class="badge bg-warning bg-opacity-25 text-dark px-2 py-1 fw-semibold">
                                <span class="text-warning">&#9733;</span> @rev.Rating / 5
                            </span>
                        </div>
                        <p class="text-muted small mb-2">@(string.IsNullOrWhiteSpace(rev.Comment) ? "No additional comment." : rev.Comment)</p>
                        <small class="text-muted">@rev.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                    </div>
                </div>
            }
        </div>
    }
</div>
