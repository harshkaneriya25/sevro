@model List<Sevro.Models.ProviderService>
@{
    ViewData["Title"] = "My Services";
    var isVerified = ViewBag.IsVerified is bool b && b;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">My Offered Services</h1>
            <p class="text-muted mb-0">Manage your service menu, descriptions, and fixed prices in &#8377;.</p>
        </div>
        <a asp-action="CreateService" class="btn btn-terracotta">
            <i class="bi bi-plus-lg me-1"></i> Add New Service
        </a>
    </div>

    @if (!isVerified)
    {
        <div class="alert alert-warning border-0 shadow-sm small mb-4">
            <i class="bi bi-clock-history me-1"></i>
            Your account is pending Admin verification. Your services will become visible to customers as soon as your profile is verified.
        </div>
    }

    @if (!Model.Any())
    {
        <div class="sc-card p-5 text-center border-0 shadow-sm">
            <i class="bi bi-tools display-5 text-muted"></i>
            <h5 class="fw-bold mt-3">No services added yet</h5>
            <p class="text-muted small">Create your first service listing to start receiving bookings.</p>
            <a asp-action="CreateService" class="btn btn-terracotta btn-sm px-4">Add Your First Service</a>
        </div>
    }
    else
    {
        <div class="sc-card border-0 shadow-sm p-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th>Service Name</th>
                            <th>Category</th>
                            <th>Fixed Price</th>
                            <th>Bookings</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@s.ServiceName</div>
                                    <small class="text-muted">@(string.IsNullOrWhiteSpace(s.Description) ? "No description" : (s.Description.Length > 90 ? s.Description.Substring(0, 90) + "..." : s.Description))</small>
                                </td>
                                <td><span class="badge bg-terracotta-soft">@s.Category.CategoryName</span></td>
                                <td class="fw-bold">&#8377;@s.Price.ToString("N2")</td>
                                <td>@s.Bookings.Count</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="EditService" asp-route-id="@s.ProviderServiceId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <form asp-action="DeleteService" asp-route-id="@s.ProviderServiceId" method="post" onsubmit="return confirm('Delete this service?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
