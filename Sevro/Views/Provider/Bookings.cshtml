@model List<Sevro.Models.Booking>
@{
    ViewData["Title"] = "Manage Bookings";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Manage Bookings</h1>
        <p class="text-muted mb-0">Accept or reject incoming requests and update active jobs through completion.</p>
    </div>

    <!-- Status Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Bookings" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-terracotta" : "btn-outline-secondary")">All</a>
        @foreach (var st in Enum.GetNames<BookingStatus>())
        {
            <a asp-action="Bookings" asp-route-status="@st" class="btn btn-sm @(string.Equals(currentStatus, st, StringComparison.OrdinalIgnoreCase) ? "btn-terracotta" : "btn-outline-secondary")">@st</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="sc-card p-5 text-center border-0 shadow-sm">
            <i class="bi bi-clipboard-x display-5 text-muted"></i>
            <h5 class="fw-bold mt-3">No bookings in this view</h5>
            <p class="text-muted small mb-0">Incoming customer requests will appear here automatically.</p>
        </div>
    }
    else
    {
        <div class="sc-card border-0 shadow-sm p-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th>Booking</th>
                            <th>Customer &amp; Address</th>
                            <th>Service Date</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th class="text-end">Workflow Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">#@b.BookingId &mdash; @b.ProviderService.ServiceName</div>
                                    <span class="badge bg-terracotta-soft fw-normal">@b.ProviderService.Category.CategoryName</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@b.Customer.FullName</div>
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@b.Customer.PhoneNumber</div>
                                    <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@b.Address.Address, @b.Address.City (@b.Address.Pincode)</div>
                                </td>
                                <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-semibold">&#8377;@b.ProviderService.Price.ToString("N0")</td>
                                <td><partial name="_StatusBadgePartial" model="b.Status" /></td>
                                <td class="text-end">
                                    @if (b.Status == BookingStatus.Pending)
                                    {
                                        <div class="d-inline-flex gap-2">
                                            <form asp-action="UpdateBookingStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.BookingId" />
                                                <input type="hidden" name="nextStatus" value="Confirmed" />
                                                <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                            </form>
                                            <form asp-action="UpdateBookingStatus" method="post" onsubmit="return confirm('Reject Booking #@b.BookingId?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.BookingId" />
                                                <input type="hidden" name="nextStatus" value="Rejected" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        </div>
                                    }
                                    else if (b.Status == BookingStatus.Confirmed)
                                    {
                                        <form asp-action="UpdateBookingStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.BookingId" />
                                            <input type="hidden" name="nextStatus" value="InProgress" />
                                            <button type="submit" class="btn btn-sm btn-info text-dark">Start Job (In Progress)</button>
                                        </form>
                                    }
                                    else if (b.Status == BookingStatus.InProgress)
                                    {
                                        <form asp-action="UpdateBookingStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.BookingId" />
                                            <input type="hidden" name="nextStatus" value="Completed" />
                                            <button type="submit" class="btn btn-sm btn-success">Mark Completed</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">Closed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
