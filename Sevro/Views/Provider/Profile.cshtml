@model Sevro.ViewModels.Provider.ProviderProfileViewModel
@{
    ViewData["Title"] = "Business Profile";
}

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none text-terracotta">Provider Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Business Profile</li>
                </ol>
            </nav>

            <!-- Profile Header with Rating Summary, Verification Badge & Live Availability Switch -->
            <div class="sc-card sc-card-accent p-4 mb-4 sc-reveal">
                <div class="row align-items-center gy-3">
                    <div class="col-md-7">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h2 class="h4 fw-bold mb-0">@Model.BusinessName</h2>
                            @if (Model.IsVerified)
                            {
                                <span class="sc-status-pill sc-status-confirmed">
                                    <i class="bi bi-patch-check-fill" aria-hidden="true"></i> Verified
                                </span>
                            }
                            else
                            {
                                <span class="sc-status-pill sc-status-pending">
                                    <span class="sc-status-dot" aria-hidden="true"></span> Pending Verification
                                </span>
                            }
                        </div>
                        <div class="small text-muted sc-tabular">
                            <i class="bi bi-star-fill text-warning me-1" aria-hidden="true"></i>
                            <strong class="text-dark">@(Model.ReviewCount > 0 ? Model.AverageRating.ToString("0.0") : "New")</strong>
                            (@Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews")) &bull; <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@Model.City
                        </div>
                    </div>
                    <div class="col-md-5 d-flex justify-content-md-end">
                        <form asp-action="ToggleAvailability" method="post" class="bg-light px-3 py-2 rounded-3 border">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Provider")" />
                            <div class="form-check form-switch sc-avail-switch mb-0 d-flex align-items-center gap-2">
                                <input class="form-check-input js-availability-switch mt-0" type="checkbox" role="switch" id="profAvailSwitch" @(Model.IsAvailable ? "checked" : "") />
                                <label class="form-check-label fw-semibold small @(Model.IsAvailable ? "text-success" : "text-secondary")" for="profAvailSwitch">
                                    @(Model.IsAvailable ? "Available for Bookings" : "Marked Unavailable")
                                </label>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Edit Business Profile Form -->
            <div class="sc-card p-4 p-md-5 sc-reveal" style="--sc-delay: 80ms;">
                <div class="sc-form-header">
                    <span class="sc-form-icon"><i class="bi bi-building-fill" aria-hidden="true"></i></span>
                    <div>
                        <div class="sc-section-eyebrow mb-0">Provider Settings</div>
                        <h3 class="h5 fw-bold mb-0">Edit Business Details</h3>
                        <p class="text-muted small mb-0">Keep your public business name, service city, and bio accurate for local customers.</p>
                    </div>
                </div>

                <form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProviderProfileId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <div class="sc-form-section-title"><i class="bi bi-briefcase-fill" aria-hidden="true"></i> Business Identity</div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="BusinessName" class="form-control" placeholder="Business Name" />
                                <label asp-for="BusinessName"></label>
                                <span asp-validation-for="BusinessName"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="FullName" class="form-control" placeholder="Owner Full Name" />
                                <label asp-for="FullName"></label>
                                <span asp-validation-for="FullName"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="City" class="form-control" placeholder="City" />
                                <label asp-for="City"></label>
                                <span asp-validation-for="City"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="ExperienceYears" type="number" min="0" max="60" class="form-control" placeholder="Years" />
                                <label asp-for="ExperienceYears"></label>
                                <span asp-validation-for="ExperienceYears"></span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="ServiceAreas" class="form-control" placeholder="e.g., Indiranagar, Koramangala, Whitefield" />
                                <label asp-for="ServiceAreas"></label>
                                <span asp-validation-for="ServiceAreas"></span>
                                <div class="form-text">Comma-separated neighborhoods or zones you cover.</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <textarea asp-for="Description" class="form-control" style="height: 115px;" placeholder="Describe your business"></textarea>
                                <label asp-for="Description"></label>
                                <span asp-validation-for="Description"></span>
                            </div>
                        </div>
                    </div>

                    <div class="sc-form-section-title pt-2 border-top"><i class="bi bi-images" aria-hidden="true"></i> Work Portfolio Photos</div>
                    <div class="mb-4">
                        <label asp-for="PortfolioPhotoUploads" class="form-label small fw-semibold"></label>
                        <input asp-for="PortfolioPhotoUploads" type="file" multiple accept=".png,.jpg,.jpeg,.webp" class="form-control" />
                        <div class="form-text">Upload up to 6 photos (PNG, JPG, WebP &bull; max 4 MB each) showcasing completed work.</div>

                        @if (Model.ExistingPortfolioPhotos.Any())
                        {
                            <div class="row row-cols-2 row-cols-sm-4 g-2 mt-2">
                                @foreach (var photo in Model.ExistingPortfolioPhotos)
                                {
                                    <div class="col">
                                        <a href="@photo" target="_blank" rel="noopener" class="d-block border rounded-3 overflow-hidden bg-light" style="aspect-ratio: 4 / 3;">
                                            <img src="@photo" alt="Portfolio work" class="w-100 h-100" style="object-fit: cover;" />
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="sc-form-section-title pt-2 border-top"><i class="bi bi-telephone-fill" aria-hidden="true"></i> Contact Details</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Email" class="form-control" readonly disabled />
                                <label asp-for="Email"></label>
                                <div class="form-text"><i class="bi bi-lock-fill me-1" aria-hidden="true"></i>Account email cannot be changed.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" inputmode="tel" />
                                <label asp-for="PhoneNumber"></label>
                                <span asp-validation-for="PhoneNumber"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-terracotta sc-btn-sheen px-4 py-2 d-inline-flex align-items-center gap-2">
                            <span>Save Profile</span>
                            <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        </button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4 py-2">Back to Dashboard</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
