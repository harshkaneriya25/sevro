@model Sevro.ViewModels.Provider.ProviderDashboardViewModel
@{
    ViewData["Title"] = "Provider Dashboard";
}

<!-- Provider Header & Live Availability Switch -->
<div class="sc-card sc-card-accent p-4 mb-4 sc-reveal">
    <div class="row align-items-center gy-3">
        <div class="col-lg-8">
            <div class="sc-section-eyebrow mb-1"><i class="bi bi-building" aria-hidden="true"></i> Provider Portal</div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">@Model.Profile.BusinessName</h1>
                @if (Model.Profile.IsVerified)
                {
                    <span class="sc-status-pill sc-status-confirmed">
                        <i class="bi bi-patch-check-fill" aria-hidden="true"></i> Verified Provider
                    </span>
                }
                else
                {
                    <span class="sc-status-pill sc-status-pending">
                        <span class="sc-status-dot" aria-hidden="true"></span> Pending Verification
                    </span>
                }
            </div>
            <div class="small text-muted sc-tabular">
                <i class="bi bi-geo-alt me-1 text-terracotta" aria-hidden="true"></i>@Model.Profile.City
                &bull; @Model.Profile.ExperienceYears yrs experience
                &bull; <i class="bi bi-star-fill text-warning me-1" aria-hidden="true"></i><strong class="text-dark">@(Model.ReviewCount > 0 ? Model.AverageRating.ToString("0.0") : "New")</strong> (@Model.ReviewCount reviews)
            </div>
        </div>

        <div class="col-lg-4 d-flex justify-content-lg-end align-items-center">
            <form asp-action="ToggleAvailability" method="post" class="d-flex align-items-center gap-2 px-3 py-2 rounded-pill border" style="background-color: var(--color-background);">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Provider")" />
                <div class="form-check form-switch sc-avail-switch mb-0 d-flex align-items-center gap-2">
                    <input class="form-check-input js-availability-switch mt-0" type="checkbox" role="switch" id="dashAvailSwitch" @(Model.Profile.IsAvailable ? "checked" : "") />
                    <label class="form-check-label fw-semibold small @(Model.Profile.IsAvailable ? "text-success" : "text-secondary")" for="dashAvailSwitch">
                        @(Model.Profile.IsAvailable ? "Available for Bookings" : "Marked Unavailable")
                    </label>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Profile.IsVerified)
    {
        <div class="alert alert-warning border-0 small mt-3 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-info-circle-fill flex-shrink-0" aria-hidden="true"></i>
            <span>Your business profile is awaiting Admin verification. You can already add your services below; once verified, they will automatically appear in the public catalog.</span>
        </div>
    }
</div>

<!-- 4 Summary Metric Tiles -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 0ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Pending Requests</div>
                    <div class="fs-2 fw-bold mt-1 text-warning sc-tabular">@Model.PendingRequests</div>
                </div>
                <span class="sc-metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-bell-fill" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 50ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Active Jobs</div>
                    <div class="fs-2 fw-bold mt-1 text-primary sc-tabular">@Model.ActiveJobs</div>
                </div>
                <span class="sc-metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 100ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Completed Jobs</div>
                    <div class="fs-2 fw-bold mt-1 text-success sc-tabular">@Model.CompletedJobs</div>
                </div>
                <span class="sc-metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check2-all" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 150ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Listed Services</div>
                    <div class="fs-2 fw-bold mt-1 sc-tabular">@Model.ListedServices</div>
                </div>
                <span class="sc-metric-icon bg-terracotta-soft"><i class="bi bi-tools" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
</div>

<!-- Incoming & Recent Bookings -->
<div class="sc-card p-0 overflow-hidden sc-reveal" style="--sc-delay: 120ms;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-4 pb-3 border-bottom">
        <h5 class="h6 fw-bold mb-0"><i class="bi bi-clipboard-check text-terracotta me-2" aria-hidden="true"></i>Recent Booking Requests</h5>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="CreateService" class="btn btn-sm btn-terracotta sc-btn-sheen rounded-pill px-3">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Add Service
            </a>
            <a asp-action="Bookings" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Manage All Bookings</a>
        </div>
    </div>

    @if (!Model.RecentBookings.Any())
    {
        <div class="text-center py-5 px-3">
            <div class="sc-empty-icon" style="width:50px;height:50px;font-size:1.35rem;"><i class="bi bi-inbox" aria-hidden="true"></i></div>
            <div class="fw-semibold small mb-1">No booking requests yet</div>
            <div class="text-muted small">Ensure your services are listed and availability is turned on.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="small text-uppercase text-muted">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Service Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Quick Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.RecentBookings)
                    {
                        var svc = b.ProviderService;
                        var priceDisplay = b.QuotedAmount.HasValue
                            ? $"₹{b.QuotedAmount.Value:N0} (Quoted)"
                            : PricingFormatter.FormatPrice(b.AgreedPrice ?? (svc.PricingType == PricingType.QuoteRequired ? null : svc.Price), svc.PricingType, svc.Unit);
                        var needsQuoteApproval = svc.PricingType == PricingType.QuoteRequired && b.IsQuoteApproved != true;
                        <tr>
                            <td class="ps-4 fw-semibold sc-tabular">#@b.BookingId</td>
                            <td>
                                <div class="fw-semibold">@b.Customer.FullName</div>
                                <small class="text-muted">@b.Address.City &bull; @b.Customer.PhoneNumber</small>
                            </td>
                            <td>
                                <div class="fw-medium">@svc.ServiceName</div>
                                <small class="text-muted sc-tabular">@priceDisplay</small>
                            </td>
                            <td class="small sc-tabular">
                                <div>@b.BookingDate.ToString("dd MMM yyyy")</div>
                                @if (!string.IsNullOrWhiteSpace(b.PreferredTimeSlot))
                                {
                                    <div class="text-muted" style="font-size:0.74rem;">@b.PreferredTimeSlot</div>
                                }
                            </td>
                            <td><partial name="_StatusBadgePartial" model="b.Status" /></td>
                            <td class="text-end pe-4">
                                <div class="sc-action-group">
                                    @if (b.Status == BookingStatus.Pending)
                                    {
                                        <form asp-action="UpdateBookingStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.BookingId" />
                                            <input type="hidden" name="nextStatus" value="Confirmed" />
                                            <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Provider")" />
                                            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2" aria-hidden="true"></i><span>Accept</span></button>
                                        </form>
                                        <form asp-action="UpdateBookingStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.BookingId" />
                                            <input type="hidden" name="nextStatus" value="Rejected" />
                                            <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Provider")" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x" aria-hidden="true"></i><span>Reject</span></button>
                                        </form>
                                    }
                                    else if (b.Status == BookingStatus.Confirmed)
                                    {
                                        if (needsQuoteApproval)
                                        {
                                            <a asp-action="Bookings" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-receipt" aria-hidden="true"></i><span>Send Quote</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.BookingId" />
                                                <input type="hidden" name="nextStatus" value="InProgress" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Provider")" />
                                                <button type="submit" class="btn btn-sm btn-info"><i class="bi bi-play-fill" aria-hidden="true"></i><span>Start Job</span></button>
                                            </form>
                                        }
                                    }
                                    else if (b.Status == BookingStatus.InProgress)
                                    {
                                        <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.BookingId" />
                                            <input type="hidden" name="nextStatus" value="Completed" />
                                            <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Provider")" />
                                            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2-all" aria-hidden="true"></i><span>Complete</span></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">&mdash;</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
