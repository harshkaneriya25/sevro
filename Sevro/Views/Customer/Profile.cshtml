@model Sevro.ViewModels.Customer.CustomerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="sc-card p-4 p-md-5 border-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="h4 fw-bold mb-1">My Profile</h2>
                        <p class="text-muted small mb-0">Keep your contact details updated for service providers.</p>
                    </div>
                    <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary">Back to Dashboard</a>
                </div>

                <form asp-action="Profile" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                        <label asp-for="FullName"></label>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" readonly disabled />
                        <label asp-for="Email"></label>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
                        <label asp-for="PhoneNumber"></label>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-terracotta px-4">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
