@model Sevro.ViewModels.Customer.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Welcome, @Model.FullName</h1>
            <p class="text-muted mb-0">Manage your service bookings, saved addresses, and reviews.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Services" asp-action="Index" class="btn btn-terracotta">
                <i class="bi bi-search me-1"></i> Browse Services
            </a>
            <a asp-action="AddAddress" class="btn btn-outline-secondary">
                <i class="bi bi-geo-alt me-1"></i> Add Address
            </a>
        </div>
    </div>

    <!-- 4 Summary Metric Tiles -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="sc-metric-tile shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted fw-medium">Total Bookings</div>
                        <div class="fs-2 fw-bold mt-1">@Model.TotalBookings</div>
                    </div>
                    <span class="sc-metric-icon bg-terracotta-soft"><i class="bi bi-calendar2-check"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-metric-tile shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted fw-medium">Active Requests</div>
                        <div class="fs-2 fw-bold mt-1 text-primary">@Model.ActiveBookings</div>
                    </div>
                    <span class="sc-metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-hourglass-split"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-metric-tile shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted fw-medium">Completed Jobs</div>
                        <div class="fs-2 fw-bold mt-1 text-success">@Model.CompletedBookings</div>
                    </div>
                    <span class="sc-metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check2-circle"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-metric-tile shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted fw-medium">Saved Addresses</div>
                        <div class="fs-2 fw-bold mt-1">@Model.SavedAddresses</div>
                    </div>
                    <span class="sc-metric-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-geo-alt-fill"></i></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Table -->
    <div class="sc-card border-0 shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Recent Bookings</h5>
            <a asp-action="Bookings" class="btn btn-sm btn-outline-terracotta">View All Bookings</a>
        </div>

        @if (!Model.RecentBookings.Any())
        {
            <div class="text-center py-4 text-muted">
                <p class="mb-2">You haven't booked any services yet.</p>
                <a asp-controller="Services" asp-action="Index" class="btn btn-terracotta btn-sm">Explore Services Catalog</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th>ID</th>
                            <th>Service</th>
                            <th>Provider</th>
                            <th>Date</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td class="fw-semibold">#@b.BookingId</td>
                                <td>
                                    <div class="fw-semibold">@b.ProviderService.ServiceName</div>
                                    <small class="text-muted">@b.ProviderService.Category.CategoryName</small>
                                </td>
                                <td>@b.ProviderService.ProviderProfile.BusinessName</td>
                                <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-semibold">&#8377;@b.ProviderService.Price.ToString("N0")</td>
                                <td><partial name="_StatusBadgePartial" model="b.Status" /></td>
                                <td class="text-end">
                                    <a asp-action="Bookings" class="btn btn-sm btn-light border">Track</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
