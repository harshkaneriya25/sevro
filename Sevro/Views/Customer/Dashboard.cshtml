@model Sevro.ViewModels.Customer.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="sc-page-header sc-reveal">
    <div>
        <div class="sc-section-eyebrow"><i class="bi bi-person-check" aria-hidden="true"></i> Customer Portal</div>
        <h1 class="h3 fw-bold mb-1">Welcome back, @Model.FullName</h1>
        <p class="text-muted small mb-0">Track your active bookings, saved addresses, and verified reviews.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="AddAddress" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-geo-alt me-1" aria-hidden="true"></i> Add Address
        </a>
        <a asp-controller="Services" asp-action="Index" class="btn btn-terracotta btn-sm sc-btn-sheen rounded-pill px-3 d-inline-flex align-items-center gap-1">
            <i class="bi bi-search" aria-hidden="true"></i>
            <span>Browse Services</span>
        </a>
    </div>
</div>

<!-- 4 Summary Metric Tiles -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 0ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Total Bookings</div>
                    <div class="fs-2 fw-bold mt-1 sc-tabular">@Model.TotalBookings</div>
                </div>
                <span class="sc-metric-icon bg-terracotta-soft"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 50ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Active Requests</div>
                    <div class="fs-2 fw-bold mt-1 text-primary sc-tabular">@Model.ActiveBookings</div>
                </div>
                <span class="sc-metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 100ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Completed Jobs</div>
                    <div class="fs-2 fw-bold mt-1 text-success sc-tabular">@Model.CompletedBookings</div>
                </div>
                <span class="sc-metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3 sc-reveal" style="--sc-delay: 150ms;">
        <div class="sc-metric-tile h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="small text-muted fw-medium">Saved Addresses</div>
                    <div class="fs-2 fw-bold mt-1 sc-tabular">@Model.SavedAddresses</div>
                </div>
                <span class="sc-metric-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
</div>

<!-- Recent Bookings Table -->
<div class="sc-card p-0 overflow-hidden sc-reveal" style="--sc-delay: 120ms;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-4 pb-3 border-bottom">
        <h5 class="h6 fw-bold mb-0"><i class="bi bi-calendar-check text-terracotta me-2" aria-hidden="true"></i>Recent Bookings</h5>
        <a asp-action="Bookings" class="btn btn-sm btn-outline-terracotta rounded-pill px-3">View All Bookings</a>
    </div>

    @if (!Model.RecentBookings.Any())
    {
        <div class="text-center py-5 px-3">
            <div class="sc-empty-icon" style="width:52px;height:52px;font-size:1.35rem;"><i class="bi bi-calendar2-plus" aria-hidden="true"></i></div>
            <div class="fw-semibold small mb-1">No bookings yet</div>
            <p class="text-muted small mb-3">Explore verified electricians, plumbers, cleaners, and repair pros near you.</p>
            <a asp-controller="Services" asp-action="Index" class="btn btn-terracotta btn-sm rounded-pill px-4">Explore Services Catalog</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="small text-uppercase text-muted">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Service</th>
                        <th>Provider</th>
                        <th>Date</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.RecentBookings)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold sc-tabular">#@b.BookingId</td>
                            <td>
                                <div class="fw-semibold">@b.ProviderService.ServiceName</div>
                                <small class="text-muted">@b.ProviderService.Category.CategoryName</small>
                            </td>
                            <td class="small">@b.ProviderService.ProviderProfile.BusinessName</td>
                            <td class="small sc-tabular">@b.BookingDate.ToString("dd MMM yyyy")</td>
                            <td class="fw-semibold sc-tabular">&#8377;@b.ProviderService.Price.ToString("N0")</td>
                            <td><partial name="_StatusBadgePartial" model="b.Status" /></td>
                            <td class="text-end pe-4">
                                <div class="sc-action-group">
                                    <a asp-action="Bookings" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye" aria-hidden="true"></i><span>Track</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
