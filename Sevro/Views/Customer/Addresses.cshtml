@model List<Sevro.Models.CustomerAddress>
@{
    ViewData["Title"] = "My Saved Addresses";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">My Saved Addresses</h1>
            <p class="text-muted mb-0">Add home or office addresses to speed up future service bookings.</p>
        </div>
        <a asp-action="AddAddress" class="btn btn-terracotta">
            <i class="bi bi-plus-lg me-1"></i> Add New Address
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="sc-card p-5 text-center border-0 shadow-sm">
            <i class="bi bi-geo-alt display-5 text-muted"></i>
            <h5 class="fw-bold mt-3">No saved addresses yet</h5>
            <p class="text-muted small">Add at least one service address before booking a professional.</p>
            <a asp-action="AddAddress" class="btn btn-terracotta btn-sm px-4">Add Your First Address</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var addr in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="sc-card p-4 border-0 shadow-sm h-100 d-flex flex-column">
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-geo-alt-fill text-terracotta fs-5"></i>
                            <div>
                                <div class="fw-semibold">@addr.Address</div>
                                <div class="small text-muted">@addr.City &ndash; @addr.Pincode</div>
                            </div>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex gap-2">
                            <a asp-action="EditAddress" asp-route-id="@addr.AddressId" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <form asp-action="DeleteAddress" asp-route-id="@addr.AddressId" method="post" onsubmit="return confirm('Delete this saved address?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
