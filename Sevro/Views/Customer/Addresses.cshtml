@model List<Sevro.Models.CustomerAddress>
@{
    ViewData["Title"] = "My Saved Addresses";
}

<div class="sc-page-header sc-reveal">
    <div>
        <div class="sc-section-eyebrow"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Locations</div>
        <h1 class="h3 fw-bold mb-1">My Saved Addresses</h1>
        <p class="text-muted small mb-0">Add home or office addresses to speed up future service bookings.</p>
    </div>
    <a asp-action="AddAddress" class="btn btn-terracotta sc-btn-sheen rounded-pill px-4 d-inline-flex align-items-center gap-1">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Add New Address</span>
    </a>
</div>

@if (!Model.Any())
{
    <div class="sc-empty-state">
        <div class="sc-empty-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></div>
        <h5 class="fw-bold">No saved addresses yet</h5>
        <p class="text-muted small mb-3">Add at least one service address before booking a local professional.</p>
        <a asp-action="AddAddress" class="btn btn-terracotta btn-sm rounded-pill px-4">Add Your First Address</a>
    </div>
}
else
{
    <div class="row g-3" data-sc-paginate="6">
        @foreach (var addr in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="sc-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <span class="sc-form-icon" style="width:40px;height:40px;font-size:1.1rem;">
                            <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                        </span>
                        <div>
                            <div class="fw-semibold">@addr.Address</div>
                            <div class="small text-muted sc-tabular">@addr.City &ndash; @addr.Pincode</div>
                        </div>
                    </div>

                    <div class="mt-auto pt-3 border-top sc-action-group justify-content-start">
                        <a asp-action="EditAddress" asp-route-id="@addr.AddressId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil" aria-hidden="true"></i><span>Edit</span>
                        </a>
                        <form asp-action="DeleteAddress" asp-route-id="@addr.AddressId" method="post" onsubmit="return confirm('Delete this saved address?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash" aria-hidden="true"></i><span>Delete</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
