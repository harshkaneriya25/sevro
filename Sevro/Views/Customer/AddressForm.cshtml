@model Sevro.ViewModels.Customer.AddressViewModel
@{
    var isEdit = Model.AddressId > 0;
    ViewData["Title"] = isEdit ? "Edit Address" : "Add New Address";
}

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none text-terracotta">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Addresses" class="text-decoration-none text-terracotta">Saved Addresses</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                </ol>
            </nav>

            <div class="sc-card sc-card-accent p-4 p-md-5 sc-reveal">
                <div class="sc-form-header">
                    <span class="sc-form-icon"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></span>
                    <div>
                        <div class="sc-section-eyebrow mb-0">Service Location</div>
                        <h2 class="h4 fw-bold mb-0">@ViewData["Title"]</h2>
                        <p class="text-muted small mb-0">Enter the complete address where the service provider should visit.</p>
                    </div>
                </div>

                <form asp-action="@(isEdit ? "EditAddress" : "AddAddress")" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AddressId" />
                    @if (!isEdit && ViewBag.ReturnUrl != null)
                    {
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    }
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Address" class="form-control" style="height: 110px;" placeholder="Flat / House No., Street, Landmark"></textarea>
                        <label asp-for="Address"></label>
                        <span asp-validation-for="Address"></span>
                        <div class="form-text">Include house/flat number, street name, and a nearby landmark for quick arrival.</div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <div class="form-floating">
                                <input asp-for="City" class="form-control" placeholder="City" />
                                <label asp-for="City"></label>
                                <span asp-validation-for="City"></span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-floating">
                                <input asp-for="Pincode" class="form-control" placeholder="Pincode" inputmode="numeric" maxlength="10" />
                                <label asp-for="Pincode"></label>
                                <span asp-validation-for="Pincode"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-terracotta sc-btn-sheen px-4 py-2 d-inline-flex align-items-center gap-2">
                            <span>@(isEdit ? "Update Address" : "Save Address")</span>
                            <i class="bi bi-arrow-right sc-cta-arrow" aria-hidden="true"></i>
                        </button>
                        <a asp-action="Addresses" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
