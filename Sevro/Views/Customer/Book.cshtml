@model Sevro.ViewModels.Customer.CreateBookingViewModel
@using Sevro.ViewModels.Catalog
@{
    ViewData["Title"] = "Book Service";
    var svc = Model.Service!;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Services" asp-action="Index" class="text-decoration-none text-terracotta">Services</a></li>
            <li class="breadcrumb-item active" aria-current="page">Book Service</li>
        </ol>
    </nav>

    <h1 class="h3 fw-bold mb-4">Confirm Your Service Booking</h1>

    <!-- Two-Column Checkout Layout -->
    <div class="row g-4">
        <!-- Left Column: Service Summary -->
        <div class="col-lg-5">
            <div class="sc-card border-0 shadow-sm overflow-hidden">
                <img src="@ServiceCardViewModel.GetCategoryThumbnail(svc.Category.CategoryName)" alt="@svc.Category.CategoryName" class="sc-card-thumb" />
                <div class="p-4">
                    <span class="badge bg-terracotta-soft mb-2">@svc.Category.CategoryName</span>
                    <h4 class="fw-bold mb-1">@svc.ServiceName</h4>
                    <div class="small text-muted mb-3">
                        by <strong class="text-dark">@svc.ProviderProfile.BusinessName</strong>
                        @if (svc.ProviderProfile.IsVerified)
                        {
                            <i class="bi bi-patch-check-fill text-primary ms-1"></i>
                        }
                        &bull; @svc.ProviderProfile.City
                    </div>

                    @if (!string.IsNullOrWhiteSpace(svc.Description))
                    {
                        <p class="small text-muted mb-3">@svc.Description</p>
                    }

                    <div class="d-flex justify-content-between align-items-center py-3 border-top border-bottom mb-3">
                        <span class="small fw-semibold">
                            <span class="text-warning">&#9733;</span>
                            @(Model.ProviderReviewCount > 0 ? Model.ProviderAverageRating.ToString("0.0") : "New")
                            <span class="text-muted fw-normal">(@Model.ProviderReviewCount reviews)</span>
                        </span>
                        <span class="fs-4 fw-bold text-dark">&#8377;@svc.Price.ToString("N0")</span>
                    </div>

                    <div class="alert alert-light border small mb-0">
                        <i class="bi bi-cash-coin text-terracotta me-1"></i>
                        <strong>Direct Payment on Service:</strong> No online payment required now. Settle directly with the provider after work completion.
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Saved Address Selector + Date Selection -->
        <div class="col-lg-7">
            <div class="sc-card p-4 p-md-5 border-0 shadow-sm">
                <h5 class="fw-bold mb-3">Booking Details</h5>

                @if (!Model.SavedAddresses.Any())
                {
                    <div class="alert alert-warning border-0">
                        <h6 class="fw-bold"><i class="bi bi-geo-alt me-1"></i> No Saved Service Address Found</h6>
                        <p class="small mb-3">You need at least one saved address to complete a booking.</p>
                        <a asp-action="AddAddress" asp-route-returnUrl="@Url.Action("Book", "Customer", new { id = svc.ProviderServiceId })" class="btn btn-terracotta btn-sm">Add a Service Address</a>
                    </div>
                }
                else
                {
                    <form asp-action="Book" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ProviderServiceId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                        <!-- Saved Address Selection -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold mb-0">Select Saved Service Address</label>
                                <a asp-action="AddAddress" asp-route-returnUrl="@Url.Action("Book", "Customer", new { id = svc.ProviderServiceId })" class="small text-terracotta text-decoration-none fw-semibold">+ Add New</a>
                            </div>

                            <div class="vstack gap-2">
                                @foreach (var addr in Model.SavedAddresses)
                                {
                                    <label class="border rounded-3 p-3 d-flex align-items-start gap-3 bg-light bg-opacity-50" style="cursor:pointer;">
                                        <input type="radio" class="form-check-input mt-1" name="AddressId" value="@addr.AddressId" @(Model.AddressId == addr.AddressId ? "checked" : "") />
                                        <div>
                                            <div class="fw-semibold">@addr.Address</div>
                                            <small class="text-muted">@addr.City &ndash; @addr.Pincode</small>
                                        </div>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="AddressId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Preferred Date Selection (Date only) -->
                        <div class="mb-4">
                            <label asp-for="BookingDate" class="form-label fw-semibold"></label>
                            <input asp-for="BookingDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <div class="form-text">Select your preferred service date. The provider will confirm your request.</div>
                            <span asp-validation-for="BookingDate" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-terracotta px-4 py-2 fw-semibold">
                                <i class="bi bi-check2-circle me-1"></i> Confirm Booking Request
                            </button>
                            <a asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
