@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="sc-card p-5 mx-auto border-0 shadow-sm" style="max-width: 540px;">
        <i class="bi bi-shield-lock text-terracotta display-4"></i>
        <h2 class="fw-bold mt-3">Access Restricted</h2>
        <p class="text-muted">You do not have permission to view this page with your current role.</p>
        <div class="d-flex justify-content-center gap-2 mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-terracotta px-4">Go Home</a>
            <a asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary px-4">Browse Services</a>
        </div>
    </div>
</div>
