@model Sevro.ViewModels.Catalog.ServiceCatalogViewModel
@{
    ViewData["Title"] = "Services Catalog";

    string BuildFilterUrl(
        string? search = null,
        int? categoryId = null,
        string? city = null,
        bool? availableOnly = null,
        List<string>? priceRanges = null,
        string? sortBy = null)
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(search)) qs.Add($"search={Uri.EscapeDataString(search)}");
        if (categoryId.HasValue) qs.Add($"categoryId={categoryId.Value}");
        if (!string.IsNullOrWhiteSpace(city)) qs.Add($"city={Uri.EscapeDataString(city)}");
        if (availableOnly == true) qs.Add("availableOnly=true");
        if (priceRanges != null)
        {
            foreach (var pr in priceRanges) qs.Add($"priceRanges={Uri.EscapeDataString(pr)}");
        }
        if (!string.IsNullOrWhiteSpace(sortBy) && sortBy != "rating") qs.Add($"sortBy={Uri.EscapeDataString(sortBy)}");
        return qs.Any() ? $"/Services?{string.Join("&", qs)}" : "/Services";
    }
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <div>
            <h1 class="h2 fw-bold mb-1">Local Services Catalog</h1>
            <p class="text-muted mb-0">Compare fixed-price offerings from admin-verified local service providers.</p>
        </div>
        <span class="badge rounded-pill bg-white border text-dark px-3 py-2 shadow-sm">
            Showing <strong>@Model.Services.Count</strong> @(Model.Services.Count == 1 ? "service" : "services")
        </span>
    </div>

    <form id="catalogFilterForm" asp-controller="Services" asp-action="Index" method="get">
        <div class="row g-4">
            <!-- Left Sticky Filter Rail (col-md-3) -->
            <aside class="col-md-3">
                <div class="sc-filter-rail p-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h6 class="fw-bold mb-0"><i class="bi bi-sliders me-1 text-terracotta"></i> Filters</h6>
                        @if (Model.HasActiveFilters)
                        {
                            <a asp-action="Index" class="small text-terracotta text-decoration-none fw-semibold">Reset</a>
                        }
                    </div>

                    <!-- Available Now Toggle Switch -->
                    <div class="form-check form-switch mb-3 pb-3 border-bottom">
                        <input class="form-check-input js-auto-submit" type="checkbox" role="switch" id="availableOnlySwitch" name="availableOnly" value="true" @(Model.AvailableOnly ? "checked" : "") />
                        <label class="form-check-label fw-medium" for="availableOnlySwitch">Available Now</label>
                    </div>

                    <!-- Category Radio List -->
                    <div class="mb-3 pb-3 border-bottom">
                        <div class="fw-semibold small text-uppercase text-muted mb-2">Category</div>
                        <div class="form-check mb-1">
                            <input class="form-check-input js-auto-submit" type="radio" name="categoryId" id="catAll" value="" @(!Model.CategoryId.HasValue ? "checked" : "") />
                            <label class="form-check-label small" for="catAll">All Categories</label>
                        </div>
                        @foreach (var cat in Model.Categories)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input js-auto-submit" type="radio" name="categoryId" id="cat_@cat.CategoryId" value="@cat.CategoryId" @(Model.CategoryId == cat.CategoryId ? "checked" : "") />
                                <label class="form-check-label small" for="cat_@cat.CategoryId">@cat.CategoryName</label>
                            </div>
                        }
                    </div>

                    <!-- Price Range Checkboxes -->
                    <div class="mb-3 pb-3 border-bottom">
                        <div class="fw-semibold small text-uppercase text-muted mb-2">Price Range (&#8377;)</div>
                        <div class="form-check mb-1">
                            <input class="form-check-input js-auto-submit" type="checkbox" name="priceRanges" value="under500" id="prUnder500" @(Model.PriceRanges.Contains("under500") ? "checked" : "") />
                            <label class="form-check-label small" for="prUnder500">Under &#8377;500</label>
                        </div>
                        <div class="form-check mb-1">
                            <input class="form-check-input js-auto-submit" type="checkbox" name="priceRanges" value="500to1500" id="pr500to1500" @(Model.PriceRanges.Contains("500to1500") ? "checked" : "") />
                            <label class="form-check-label small" for="pr500to1500">&#8377;500 &ndash; &#8377;1,500</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input js-auto-submit" type="checkbox" name="priceRanges" value="above1500" id="prAbove1500" @(Model.PriceRanges.Contains("above1500") ? "checked" : "") />
                            <label class="form-check-label small" for="prAbove1500">Above &#8377;1,500</label>
                        </div>
                    </div>

                    <!-- City Dropdown -->
                    <div class="mb-3">
                        <label class="fw-semibold small text-uppercase text-muted mb-2 d-block" for="cityFilter">City</label>
                        <select class="form-select form-select-sm js-auto-submit" id="cityFilter" name="city">
                            <option value="">All Cities</option>
                            @foreach (var c in Model.Cities)
                            {
                                <option value="@c" selected="@(Model.City == c)">@c</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-terracotta btn-sm w-100">Apply Filters</button>
                </div>
            </aside>

            <!-- Main Catalog Area (col-md-9) -->
            <div class="col-md-9">
                <!-- Search Bar + Sort Dropdown -->
                <div class="sc-card p-3 mb-3 border-0 shadow-sm">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search services, providers, or categories..." />
                                <button type="submit" class="btn btn-terracotta px-3">Search</button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted small">Sort</span>
                                <select name="sortBy" class="form-select js-auto-submit">
                                    <option value="rating" selected="@(Model.SortBy == "rating")">Highest Rating</option>
                                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Active Removable Filter Tags -->
                    @if (Model.HasActiveFilters)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
                            <span class="small text-muted fw-medium">Active:</span>

                            @if (!string.IsNullOrWhiteSpace(Model.Search))
                            {
                                <a class="sc-filter-tag" href="@BuildFilterUrl(null, Model.CategoryId, Model.City, Model.AvailableOnly, Model.PriceRanges, Model.SortBy)">
                                    Search: "@Model.Search" <i class="bi bi-x"></i>
                                </a>
                            }
                            @if (Model.AvailableOnly)
                            {
                                <a class="sc-filter-tag" href="@BuildFilterUrl(Model.Search, Model.CategoryId, Model.City, false, Model.PriceRanges, Model.SortBy)">
                                    Available Now <i class="bi bi-x"></i>
                                </a>
                            }
                            @if (Model.CategoryId.HasValue && Model.SelectedCategoryName != null)
                            {
                                <a class="sc-filter-tag" href="@BuildFilterUrl(Model.Search, null, Model.City, Model.AvailableOnly, Model.PriceRanges, Model.SortBy)">
                                    Category: @Model.SelectedCategoryName <i class="bi bi-x"></i>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.City))
                            {
                                <a class="sc-filter-tag" href="@BuildFilterUrl(Model.Search, Model.CategoryId, null, Model.AvailableOnly, Model.PriceRanges, Model.SortBy)">
                                    City: @Model.City <i class="bi bi-x"></i>
                                </a>
                            }
                            @foreach (var pr in Model.PriceRanges)
                            {
                                var prLabel = pr switch
                                {
                                    "under500" => "Under ₹500",
                                    "500to1500" => "₹500 – ₹1,500",
                                    "above1500" => "Above ₹1,500",
                                    _ => pr
                                };
                                var remaining = Model.PriceRanges.Where(x => x != pr).ToList();
                                <a class="sc-filter-tag" href="@BuildFilterUrl(Model.Search, Model.CategoryId, Model.City, Model.AvailableOnly, remaining, Model.SortBy)">
                                    @prLabel <i class="bi bi-x"></i>
                                </a>
                            }
                        </div>
                    }
                </div>

                <!-- 3-Column Service Card Grid -->
                @if (!Model.Services.Any())
                {
                    <div class="sc-card p-5 text-center border-0 shadow-sm">
                        <i class="bi bi-search display-5 text-muted"></i>
                        <h5 class="fw-bold mt-3">No matching services found</h5>
                        <p class="text-muted small">Try clearing one or more filters or searching a different keyword.</p>
                        <a asp-action="Index" class="btn btn-outline-terracotta btn-sm px-4">Clear All Filters</a>
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        @foreach (var svc in Model.Services)
                        {
                            <div class="col">
                                <div class="card sc-service-card h-100">
                                    <div class="position-relative">
                                        <img src="@svc.ThumbnailUrl" alt="@svc.CategoryName" class="sc-card-thumb" />
                                        <span class="badge bg-white text-dark shadow-sm position-absolute top-0 start-0 m-2">@svc.CategoryName</span>
                                        @if (svc.IsAvailable)
                                        {
                                            <span class="badge bg-success position-absolute top-0 end-0 m-2">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary position-absolute top-0 end-0 m-2">Unavailable</span>
                                        }
                                    </div>

                                    <div class="card-body d-flex flex-column">
                                        <h6 class="card-title fw-bold mb-1">@svc.ServiceName</h6>
                                        <a asp-action="ProviderDetails" asp-route-id="@svc.ProviderProfileId" class="text-decoration-none text-muted small mb-2 d-inline-flex align-items-center gap-1">
                                            <span>@svc.BusinessName</span>
                                            @if (svc.IsVerified)
                                            {
                                                <i class="bi bi-patch-check-fill text-primary" title="Verified Provider"></i>
                                            }
                                        </a>
                                        <div class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@svc.City</div>

                                        @if (!string.IsNullOrWhiteSpace(svc.Description))
                                        {
                                            <p class="small text-muted mb-3">
                                                @(svc.Description.Length > 85 ? svc.Description.Substring(0, 85) + "..." : svc.Description)
                                            </p>
                                        }

                                        <div class="mt-auto">
                                            <div class="d-flex justify-content-between align-items-center mb-3 pt-2 border-top">
                                                <span class="small fw-semibold">
                                                    <span class="text-warning">&#9733;</span>
                                                    @(svc.ReviewCount > 0 ? svc.AverageRating.ToString("0.0") : "New")
                                                    <span class="text-muted fw-normal">(@svc.ReviewCount)</span>
                                                </span>
                                                <span class="fs-5 fw-bold text-dark">&#8377;@svc.Price.ToString("N0")</span>
                                            </div>

                                            @if (svc.IsAvailable)
                                            {
                                                <a asp-controller="Customer" asp-action="Book" asp-route-id="@svc.ProviderServiceId" class="btn btn-terracotta w-100">
                                                    Book Service
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-secondary w-100" disabled>Unavailable</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </form>
</div>
