@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    ApplicationUser? currentUser = null;
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sevro</title>

    <!-- Sevro Custom Favicon (from uploaded image) -->
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/favicon.png" asp-append-version="true" />

    <!-- Fonts & Bootstrap 5.3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg sc-navbar py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 text-dark" asp-controller="Home" asp-action="Index">
                    <img src="~/images/favicon.png" alt="Sevro Logo" class="sc-brand-icon" asp-append-version="true" />
                    <span>Sev<span class="text-terracotta">ro</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Services" && currentAction == "Index" ? "active" : "")" asp-controller="Services" asp-action="Index">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Services" && currentAction == "Providers" ? "active" : "")" asp-controller="Services" asp-action="Providers">Providers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var roleLabel = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Provider") ? "Provider" : "Customer";
                            var dashboardController = roleLabel;

                            <a class="btn btn-sm btn-outline-terracotta px-3" asp-controller="@dashboardController" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>

                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2 px-3 py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-terracotta"></i>
                                    <span class="fw-medium">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                    <span class="badge rounded-pill bg-terracotta-soft">@roleLabel</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                    @if (User.IsInRole("Customer"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-grid me-2"></i>Customer Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Customer" asp-action="Bookings"><i class="bi bi-calendar-check me-2"></i>My Bookings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Customer" asp-action="Addresses"><i class="bi bi-geo-alt me-2"></i>My Addresses</a></li>
                                        <li><a class="dropdown-item" asp-controller="Customer" asp-action="Reviews"><i class="bi bi-star me-2"></i>My Reviews</a></li>
                                        <li><a class="dropdown-item" asp-controller="Customer" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                    }
                                    else if (User.IsInRole("Provider"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Provider" asp-action="Dashboard"><i class="bi bi-grid me-2"></i>Provider Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Provider" asp-action="Services"><i class="bi bi-tools me-2"></i>My Services</a></li>
                                        <li><a class="dropdown-item" asp-controller="Provider" asp-action="Bookings"><i class="bi bi-clipboard-check me-2"></i>Manage Bookings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Provider" asp-action="Reviews"><i class="bi bi-star me-2"></i>Customer Reviews</a></li>
                                        <li><a class="dropdown-item" asp-controller="Provider" asp-action="Profile"><i class="bi bi-building me-2"></i>Business Profile</a></li>
                                    }
                                    else if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-grid me-2"></i>Admin Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Manage Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags me-2"></i>Manage Categories</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Providers"><i class="bi bi-patch-check me-2"></i>Verify Providers</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Bookings"><i class="bi bi-journal-text me-2"></i>Manage Bookings</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-secondary btn-sm px-3 py-2" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-terracotta btn-sm px-3 py-2" asp-controller="Account" asp-action="Register">Get Started</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-0" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="sc-footer mt-5 py-4">
        <div class="container">
            <div class="row gy-3 align-items-center">
                <div class="col-md-5 d-flex align-items-center gap-2">
                    <img src="~/images/favicon.png" alt="Sevro" class="sc-brand-icon" asp-append-version="true" />
                    <div>
                        <div class="fw-bold">Sev<span class="text-terracotta">ro</span></div>
                        <small class="text-muted">Trusted Local Service Marketplace &bull; Pay directly on service</small>
                    </div>
                </div>
                <div class="col-md-4 text-md-center">
                    <a class="text-decoration-none text-muted me-3 small" asp-controller="Services" asp-action="Index">Browse Services</a>
                    <a class="text-decoration-none text-muted me-3 small" asp-controller="Services" asp-action="Providers">Find Providers</a>
                    <a class="text-decoration-none text-muted small" asp-controller="Home" asp-action="About">About Us</a>
                </div>
                <div class="col-md-3 text-md-end">
                    <small class="text-muted">&copy; @DateTime.Now.Year Sevro (BCA TY Project)</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
