@model BookingStatus

@if (Model == BookingStatus.Cancelled || Model == BookingStatus.Rejected)
{
    <div class="d-flex align-items-center gap-2 p-2 px-3 rounded-3 small fw-semibold" style="background-color: var(--color-destructive-bg); color: var(--color-destructive-text); border: 1px solid rgba(220, 38, 38, 0.2);">
        <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
        <span>
            @(Model == BookingStatus.Cancelled
                ? "This booking was cancelled."
                : "This booking request was declined by the service provider.")
        </span>
    </div>
}
else
{
    var stepIndex = Model switch
    {
        BookingStatus.Pending => 0,
        BookingStatus.Confirmed => 1,
        BookingStatus.InProgress => 2,
        BookingStatus.Completed => 3,
        _ => 0
    };

    <div class="sc-stepper" aria-label="Booking progress: @Model">
        <div class="sc-step @(stepIndex > 0 ? "completed" : "active-pending")">
            <div class="sc-step-dot">
                @if (stepIndex > 0) { <i class="bi bi-check-lg" aria-hidden="true"></i> } else { <i class="bi bi-clock" aria-hidden="true"></i> }
            </div>
            <div class="sc-step-label">Pending</div>
        </div>
        <div class="sc-step @(stepIndex > 1 ? "completed" : stepIndex == 1 ? "active-confirmed" : "")">
            <div class="sc-step-dot">
                @if (stepIndex > 1) { <i class="bi bi-check-lg" aria-hidden="true"></i> } else if (stepIndex == 1) { <i class="bi bi-check2-circle" aria-hidden="true"></i> } else { <span>2</span> }
            </div>
            <div class="sc-step-label">Confirmed</div>
        </div>
        <div class="sc-step @(stepIndex > 2 ? "completed" : stepIndex == 2 ? "active-inprogress" : "")">
            <div class="sc-step-dot">
                @if (stepIndex > 2) { <i class="bi bi-check-lg" aria-hidden="true"></i> } else if (stepIndex == 2) { <i class="bi bi-tools" aria-hidden="true"></i> } else { <span>3</span> }
            </div>
            <div class="sc-step-label">In Progress</div>
        </div>
        <div class="sc-step @(stepIndex == 3 ? "active-completed" : "")">
            <div class="sc-step-dot">
                @if (stepIndex == 3) { <i class="bi bi-patch-check-fill" aria-hidden="true"></i> } else { <span>4</span> }
            </div>
            <div class="sc-step-label">Completed</div>
        </div>
    </div>
}
