@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="sc-card p-5 mx-auto" style="max-width: 560px;">
        <i class="bi bi-exclamation-octagon text-terracotta display-4"></i>
        <h2 class="mt-3 fw-bold">Something went wrong</h2>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-terracotta mt-2 px-4">Return Home</a>
    </div>
</div>
