@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentUser = int.TryParse(UserManager.GetUserId(User), out _)
        ? await UserManager.GetUserAsync(User)
        : null;
    var fullName = currentUser?.FullName ?? User.Identity?.Name ?? "User";
    var email = currentUser?.Email ?? "";
    var roleLabel = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Provider") ? "Provider" : "Customer";

    var initials = string.Concat(
        fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(s => char.ToUpperInvariant(s[0]))
    );
    if (string.IsNullOrEmpty(initials)) initials = "U";

    bool IsActive(string ctrl, params string[] actions) =>
        string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) &&
        actions.Any(a => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase));
}

<div class="sc-sidebar-inner d-flex flex-column h-100">
    <!-- User Identity Card -->
    <div class="sc-sidebar-profile mb-3">
        <div class="d-flex align-items-center gap-3">
            <span class="sc-avatar-circle flex-shrink-0">@initials</span>
            <div class="min-w-0">
                <div class="fw-bold text-truncate small" style="color: var(--color-secondary);">@fullName</div>
                <div class="text-muted text-truncate" style="font-size: 0.74rem;">@email</div>
                <span class="badge rounded-pill bg-terracotta-soft mt-1" style="font-size: 0.68rem;">
                    <i class="bi bi-shield-check me-1" aria-hidden="true"></i>@roleLabel Portal
                </span>
            </div>
        </div>
    </div>

    <!-- Role Navigation Menu -->
    <nav class="sc-sidebar-nav flex-grow-1" aria-label="@roleLabel sidebar navigation">
        @if (User.IsInRole("Admin"))
        {
            <div class="sc-sidebar-section-label">Overview</div>
            <a class="sc-sidebar-link @(IsActive("Admin", "Dashboard") ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-speedometer2" aria-hidden="true"></i><span>Admin Dashboard</span>
            </a>

            <div class="sc-sidebar-section-label mt-3">Management</div>
            <a class="sc-sidebar-link @(IsActive("Admin", "Users") ? "active" : "")" asp-controller="Admin" asp-action="Users">
                <i class="bi bi-people" aria-hidden="true"></i><span>Manage Users</span>
            </a>
            <a class="sc-sidebar-link @(IsActive("Admin", "Providers") ? "active" : "")" asp-controller="Admin" asp-action="Providers">
                <i class="bi bi-patch-check" aria-hidden="true"></i><span>Verify Providers</span>
            </a>
            <a class="sc-sidebar-link @(IsActive("Admin", "Categories", "CreateCategory", "EditCategory") ? "active" : "")" asp-controller="Admin" asp-action="Categories">
                <i class="bi bi-tags" aria-hidden="true"></i><span>Service Categories</span>
            </a>
            <a class="sc-sidebar-link @(IsActive("Admin", "Services", "CreateService", "EditService") ? "active" : "")" asp-controller="Admin" asp-action="Services">
                <i class="bi bi-list-check" aria-hidden="true"></i><span>Service Catalog</span>
            </a>
            <a class="sc-sidebar-link @(IsActive("Admin", "Bookings") ? "active" : "")" asp-controller="Admin" asp-action="Bookings">
                <i class="bi bi-journal-check" aria-hidden="true"></i><span>Platform Bookings</span>
            </a>

            <div class="sc-sidebar-section-label mt-3">Quick Actions</div>
            <a class="sc-sidebar-link" asp-controller="Admin" asp-action="CreateService">
                <i class="bi bi-plus-circle" aria-hidden="true"></i><span>Add Catalog Service</span>
            </a>
            <a class="sc-sidebar-link" asp-controller="Admin" asp-action="CreateCategory">
                <i class="bi bi-folder-plus" aria-hidden="true"></i><span>Add New Category</span>
            </a>
            <a class="sc-sidebar-link" asp-controller="Services" asp-action="Index">
                <i class="bi bi-shop" aria-hidden="true"></i><span>Public Catalog</span>
            </a>
        }
        else if (User.IsInRole("Provider"))
        {
            <div class="sc-sidebar-section-label">Overview</div>
            <a class="sc-sidebar-link @(IsActive("Provider", "Dashboard") ? "active" : "")" asp-controller="Provider" asp-action="Dashboard">
                <i class="bi bi-speedometer2" aria-hidden="true"></i><span>Provider Dashboard</span>
            </a>

            <div class="sc-sidebar-section-label mt-3">Operations</div>
            <a class="sc-sidebar-link @(IsActive("Provider", "Services", "CreateService", "EditService") ? "active" : "")" asp-controller="Provider" asp-action="Services">
                <i class="bi bi-tools" aria-hidden="true"></i><span>My Services</span>
            </a>
            <a class="sc-sidebar-link @(IsActive("Provider", "Bookings") ? "active" : "")" asp-controller="Provider" asp-action="Bookings">
                <i class="bi bi-clipboard-check" aria-hidden="true"></i><span>Manage Bookings</span>
            </a>
            <a class="sc-sidebar-link @(IsActive("Provider", "Reviews") ? "active" : "")" asp-controller="Provider" asp-action="Reviews">
                <i class="bi bi-star" aria-hidden="true"></i><span>Customer Reviews</span>
            </a>

            <div class="sc-sidebar-section-label mt-3">Account</div>
            <a class="sc-sidebar-link @(IsActive("Provider", "Profile") ? "active" : "")" asp-controller="Provider" asp-action="Profile">
                <i class="bi bi-building" aria-hidden="true"></i><span>Business Profile</span>
            </a>
            <a class="sc-sidebar-link" asp-controller="Provider" asp-action="CreateService">
                <i class="bi bi-plus-circle" aria-hidden="true"></i><span>Publish New Service</span>
            </a>
        }
        else if (User.IsInRole("Customer"))
        {
            <div class="sc-sidebar-section-label">Overview</div>
            <a class="sc-sidebar-link @(IsActive("Customer", "Dashboard") ? "active" : "")" asp-controller="Customer" asp-action="Dashboard">
                <i class="bi bi-speedometer2" aria-hidden="true"></i><span>Customer Dashboard</span>
            </a>

            <div class="sc-sidebar-section-label mt-3">Activity</div>
            <a class="sc-sidebar-link @(IsActive("Customer", "Bookings") ? "active" : "")" asp-controller="Customer" asp-action="Bookings">
                <i class="bi bi-calendar-check" aria-hidden="true"></i><span>My Bookings</span>
            </a>
            <a class="sc-sidebar-link @(IsActive("Customer", "Addresses", "AddAddress", "EditAddress") ? "active" : "")" asp-controller="Customer" asp-action="Addresses">
                <i class="bi bi-geo-alt" aria-hidden="true"></i><span>Saved Addresses</span>
            </a>
            <a class="sc-sidebar-link @(IsActive("Customer", "Reviews") ? "active" : "")" asp-controller="Customer" asp-action="Reviews">
                <i class="bi bi-star" aria-hidden="true"></i><span>My Reviews</span>
            </a>

            <div class="sc-sidebar-section-label mt-3">Account</div>
            <a class="sc-sidebar-link @(IsActive("Customer", "Profile") ? "active" : "")" asp-controller="Customer" asp-action="Profile">
                <i class="bi bi-person" aria-hidden="true"></i><span>My Profile</span>
            </a>
            <a class="sc-sidebar-link" asp-controller="Services" asp-action="Index">
                <i class="bi bi-search" aria-hidden="true"></i><span>Browse Services</span>
            </a>
        }
    </nav>

    <!-- Bottom Sign Out -->
    <div class="pt-3 mt-3 border-top">
        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="sc-sidebar-link sc-sidebar-logout w-100 border-0 bg-transparent text-start">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Sign Out</span>
            </button>
        </form>
    </div>
</div>
