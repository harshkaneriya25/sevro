@model BookingStatus
@{
    var (statusClass, label) = Model switch
    {
        BookingStatus.Pending => ("sc-status-pending", "Pending"),
        BookingStatus.Confirmed => ("sc-status-confirmed", "Confirmed"),
        BookingStatus.InProgress => ("sc-status-inprogress", "In Progress"),
        BookingStatus.Completed => ("sc-status-completed", "Completed"),
        BookingStatus.Rejected => ("sc-status-danger", "Rejected"),
        BookingStatus.Cancelled => ("sc-status-danger", "Cancelled"),
        _ => ("sc-status-muted", Model.ToString())
    };
}
<span class="sc-status-pill @statusClass">
    <span class="sc-status-dot" aria-hidden="true"></span>
    <span>@label</span>
</span>
